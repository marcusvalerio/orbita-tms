# ÓRBITA TMS — variáveis de ambiente.
# Copie para .env.local (nunca versionado) e preencha. Detalhes em
# docs/orbita-2.0/phase-1/SETUP.md. NUNCA coloque chaves reais neste arquivo.

# --- Modo de execução --------------------------------------------------------------
# demo        (padrão) operação no navegador, sem banco nem login
# production  Neon PostgreSQL + Neon Auth + RBAC
ORBITA_MODE=demo

# --- Banco (Modo Produção) ------------------------------------------------------------
# Connection string POOLED do Neon (host com "-pooler") para a aplicação.
DATABASE_URL=
# Connection string DIRETA (sem pooler) para migrations — opcional; se vazia, usa DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Autenticação (Modo Produção) ------------------------------------------------------
# neon (padrão) | dev (somente desenvolvimento/E2E, exige opt-in abaixo)
ORBITA_AUTH_PROVIDER=neon
# Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=
# 32+ caracteres aleatórios: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Provedor local (NUNCA em produção; bloqueado quando VERCEL_ENV=production)
# ORBITA_ALLOW_INSECURE_DEV_AUTH=true
# ORBITA_DEV_AUTH_SECRET=
# ORBITA_DEV_AUTH_PASSWORD=

# --- Google Maps Platform ---------------------------------------------------------------
# Chave de NAVEGADOR (Maps JavaScript API). Chega ao navegador por natureza:
# restrinja por HTTP referrer e por API no Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# Map ID (Cloud-based map styling). Sem ele, usa DEMO_MAP_ID (só para testes).
GOOGLE_MAPS_MAP_ID=
# Chave de SERVIDOR (Routes API + Geocoding API). Nunca enviada ao navegador.
# Obrigatória no Modo Produção para rotas reais; sem ela, rotas são estimadas.
GOOGLE_MAPS_SERVER_API_KEY=
